/// The audio timeline for exactly one visual composition. The visual
/// composition owns the duration: an audio track may not redefine the length of
/// the finished piece.
model AudioComposition {
  id             String                 @id @default(cuid(2))
  projectId      String
  compositionId  String                 @unique
  name           String
  sampleRate     Int                    @default(48000)
  channels       Int                    @default(2)
  durationMs     Int
  status         AudioCompositionStatus @default(DRAFT)
  createdById    String
  createdAt      TimestamptzString      @default(now())
  updatedAt      temporal.updatedAtString()

  composition    VisualComposition      @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  tracks         AudioTrack[]
  renderJobs     AudioRenderJob[]

  @@index([projectId, createdAt], map: "audio_composition_project_created_idx")
  @@index([projectId, status], map: "audio_composition_project_status_idx")
  @@map("audio_composition")
}

model AudioTrack {
  id                 String        @id @default(cuid(2))
  audioCompositionId String
  kind               AudioTrackKind
  name               String

  sourceRef          String
  startMs            Int           @default(0)
  sourceOffsetMs     Int           @default(0)
  durationMs         Int

  gainDb             Float         @default(0)
  pan                Float         @default(0)
  fadeInMs           Int           @default(0)
  fadeOutMs          Int           @default(0)

  mute               Boolean       @default(false)
  solo               Boolean       @default(false)
  duckVoiceoverDb    Float?

  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  composition        AudioComposition @relation(fields: [audioCompositionId], references: [id], onDelete: Cascade)
  automation         AudioAutomationPoint[]

  @@index([audioCompositionId, startMs], map: "audio_track_composition_start_idx")
  @@index([audioCompositionId, kind], map: "audio_track_composition_kind_idx")
  @@map("audio_track")
}

model AudioAutomationPoint {
  id        String                  @id @default(cuid(2))
  trackId   String
  property  AudioAutomationProperty
  timeMs    Int
  value     Float
  easing    AudioEasing             @default(LINEAR)
  createdAt TimestamptzString       @default(now())

  track     AudioTrack              @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, property, timeMs], map: "audio_automation_track_property_time_key")
  @@index([trackId, property, timeMs], map: "audio_automation_track_property_time_idx")
  @@map("audio_automation_point")
}

model AudioRenderJob {
  id                 String            @id @default(cuid(2))
  projectId          String
  audioCompositionId String
  videoRenderJobId   String?
  requestedById      String

  status             RenderJobStatus   @default(QUEUED)
  outputFormat       AudioOutputFormat

  contractVersion    Int
  // The exact AudioGraph snapshot used for this render, serialised as JSON text.
  audioGraph         String
  audioSha256        String

  progressPct        Int               @default(0)

  sampleRate         Int
  channels           Int
  durationMs         Int

  ffmpegVersion      String?
  errorCode          String?
  errorMessage       String?

  createdAt          TimestamptzString @default(now())
  startedAt          TimestamptzString?
  finishedAt         TimestamptzString?
  updatedAt          temporal.updatedAtString()

  audioComposition   AudioComposition  @relation(fields: [audioCompositionId], references: [id], onDelete: Cascade)
  audioArtifact      AudioArtifact?
  muxedArtifact      MuxedVideoArtifact?

  @@index([projectId, createdAt], map: "audio_render_job_project_created_idx")
  @@index([projectId, status, createdAt], map: "audio_render_job_project_status_created_idx")
  @@index([audioCompositionId, createdAt], map: "audio_render_job_composition_created_idx")
  @@map("audio_render_job")
}

model AudioArtifact {
  id               String            @id @default(cuid(2))
  audioRenderJobId String            @unique
  projectId        String

  storageKey       String
  mimeType         String
  byteSize         Int
  checksumSha256   String

  createdAt        TimestamptzString @default(now())

  renderJob        AudioRenderJob    @relation(fields: [audioRenderJobId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt], map: "audio_artifact_project_created_idx")
  @@map("audio_artifact")
}

model MuxedVideoArtifact {
  id               String            @id @default(cuid(2))
  audioRenderJobId String            @unique
  projectId        String
  videoRenderJobId String

  storageKey       String
  mimeType         String
  byteSize         Int
  checksumSha256   String

  createdAt        TimestamptzString @default(now())

  renderJob        AudioRenderJob    @relation(fields: [audioRenderJobId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt], map: "muxed_video_artifact_project_created_idx")
  @@index([projectId, videoRenderJobId], map: "muxed_video_artifact_project_video_idx")
  @@map("muxed_video_artifact")
