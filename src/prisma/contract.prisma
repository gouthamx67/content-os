// use prisma-8
enum WorkspaceRole {
  @@type("pg/text@1")

  OWNER = "OWNER"
  ADMIN = "ADMIN"
  MEMBER = "MEMBER"
}

enum ProjectStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  ARCHIVED = "ARCHIVED"
}

enum SourceType {
  @@type("pg/text@1")

  WEBSITE = "WEBSITE"
  WEB_APP = "WEB_APP"
  GITHUB = "GITHUB"
  GITLAB = "GITLAB"
  LOCAL_PROJECT = "LOCAL_PROJECT"
  ZIP = "ZIP"
  DOCUMENT = "DOCUMENT"
  PDF = "PDF"
  IMAGE = "IMAGE"
  VIDEO = "VIDEO"
  AUDIO = "AUDIO"
  FIGMA = "FIGMA"
  TEXT = "TEXT"
  OTHER = "OTHER"
}

enum SourceStatus {
  @@type("pg/text@1")

  QUEUED = "QUEUED"
  PROCESSING = "PROCESSING"
  READY = "READY"
  FAILED = "FAILED"
}

enum AssetType {
  @@type("pg/text@1")

  IMAGE = "IMAGE"
  VIDEO = "VIDEO"
  AUDIO = "AUDIO"
  DOCUMENT = "DOCUMENT"
  LOGO = "LOGO"
  SCREENSHOT = "SCREENSHOT"
  UI_CAPTURE = "UI_CAPTURE"
  OTHER = "OTHER"
}

model User {
  id           String                     @id @default(cuid(2))
  email        String                     @unique
  passwordHash String
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  sessions     Session[]
  memberships  WorkspaceMember[]

  @@map("user")
}

model Session {
  id        String            @id @default(cuid(2))
  userId    String
  tokenHash String            @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  user      User              @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Workspace {
  id        String                     @id @default(cuid(2))
  name      String
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  members   WorkspaceMember[]
  projects  Project[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String            @id @default(cuid(2))
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   TimestamptzString @default(now())

  workspace   Workspace         @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  user        User              @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

model Project {
  id                          String                       @id @default(cuid(2))
  workspaceId                 String
  name                        String
  status                      ProjectStatus                @default(ACTIVE)
  createdAt                   TimestamptzString            @default(now())
  updatedAt                   temporal.updatedAtString()

  workspace                   Workspace                    @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  sources                     Source[]
  assets                      Asset[]

  intelligenceProduct         IntelligenceProduct?
  intelligenceEvidence        IntelligenceEvidence[]
  intelligenceFeatures        IntelligenceFeature[]
  intelligenceProblems        IntelligenceProblem[]
  intelligenceBenefits        IntelligenceBenefit[]
  intelligenceClaims          IntelligenceClaim[]
  intelligenceWorkflows       IntelligenceWorkflow[]
  intelligenceAudienceSignals IntelligenceAudienceSignal[]
  intelligenceBrandSignals    IntelligenceBrandSignal[]
  intelligenceAssets          IntelligenceAsset[]
  intelligenceRelationships   IntelligenceRelationship[]
  intelligenceRuns            IntelligenceRun[]
  intelligenceSnapshots       IntelligenceSnapshot[]
  browserSessions             BrowserSession[]

  brandProfile                BrandProfile?
  brandColors                 BrandColor[]
  brandFonts                  BrandFont[]
  brandAssets                 BrandAsset[]
  brandTerms                  BrandTerm[]
  brandVoiceSignals           BrandVoiceSignal[]
  brandGuidelines             BrandGuideline[]
  brandConflicts              BrandConflict[]
  brandSourceStates           BrandSourceState[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("project")
}

model Source {
  id                   String                     @id @default(cuid(2))
  projectId            String
  type                 SourceType
  name                 String
  uri                  String?
  metadata             String?
  status               SourceStatus               @default(READY)
  mimeType             String?
  sizeBytes            Int?
  contentHash          String?
  storageKey           String?
  errorCode            String?
  errorMessage         String?
  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()

  project              Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  intelligenceEvidence IntelligenceEvidence[]
  intelligenceClaims   IntelligenceClaim[]
  intelligenceAssets   IntelligenceAsset[]
  browserSessions      BrowserSession[]
  brandSourceStates    BrandSourceState[]

  @@index([projectId])
  @@index([projectId, contentHash])
  @@index([storageKey])
  @@map("source")
}

model Asset {
  id          String                     @id @default(cuid(2))
  projectId   String
  type        AssetType
  name        String
  uri         String
  metadata    String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  brandAssets BrandAsset[]

  @@index([projectId])
  @@map("asset")
}

enum IntelligenceConfidence {
  @@type("pg/text@1")

  HIGH = "HIGH"
  MEDIUM = "MEDIUM"
  LOW = "LOW"
}

enum AssertionKind {
  @@type("pg/text@1")

  FACT = "FACT"
  INFERENCE = "INFERENCE"
  USER_PROVIDED = "USER_PROVIDED"
  MARKETING_CLAIM = "MARKETING_CLAIM"
}

enum ClaimVerification {
  @@type("pg/text@1")

  SUPPORTED = "SUPPORTED"
  PARTIALLY_SUPPORTED = "PARTIALLY_SUPPORTED"
  UNVERIFIED = "UNVERIFIED"
  CONFLICTING = "CONFLICTING"
  CONTRADICTED = "CONTRADICTED"
}

enum ClaimType {
  @@type("pg/text@1")

  CAPABILITY = "CAPABILITY"
  INTEGRATION = "INTEGRATION"
  FORMAT = "FORMAT"
  LIMITATION = "LIMITATION"
  PRICING = "PRICING"
  PERFORMANCE = "PERFORMANCE"
  OTHER = "OTHER"
}

enum IntelligenceEvidenceKind {
  @@type("pg/text@1")

  SOURCE_FRAGMENT = "SOURCE_FRAGMENT"
  REPOSITORY_FILE = "REPOSITORY_FILE"
  URL_SECTION = "URL_SECTION"
  DOCUMENT_SECTION = "DOCUMENT_SECTION"
  IMAGE_REGION = "IMAGE_REGION"
  VIDEO_TIMESTAMP = "VIDEO_TIMESTAMP"
  AUDIO_TIMESTAMP = "AUDIO_TIMESTAMP"
  EXTRACTED_METADATA = "EXTRACTED_METADATA"
  BROWSER_INTERACTION = "BROWSER_INTERACTION"
}

enum ExtractionMethod {
  @@type("pg/text@1")

  DETERMINISTIC = "DETERMINISTIC"
  AI_INTERPRETATION = "AI_INTERPRETATION"
  USER_INPUT = "USER_INPUT"
}

enum FeatureCategory {
  @@type("pg/text@1")

  AI_GENERATION = "AI_GENERATION"
  DASHBOARD = "DASHBOARD"
  AUTHENTICATION = "AUTHENTICATION"
  INTEGRATION = "INTEGRATION"
  AUTOMATION = "AUTOMATION"
  ANALYTICS = "ANALYTICS"
  COLLABORATION = "COLLABORATION"
  CONTENT_MANAGEMENT = "CONTENT_MANAGEMENT"
  EXPORT = "EXPORT"
  OTHER = "OTHER"
}

enum Importance {
  @@type("pg/text@1")

  PRIMARY = "PRIMARY"
  SECONDARY = "SECONDARY"
  TERTIARY = "TERTIARY"
}

enum AudienceSignalKind {
  @@type("pg/text@1")

  EXPLICIT_SEGMENT = "EXPLICIT_SEGMENT"
  VOCABULARY = "VOCABULARY"
  USE_CASE = "USE_CASE"
  CONTEXTUAL = "CONTEXTUAL"
}

enum BrandSignalKind {
  @@type("pg/text@1")

  BRAND_NAME = "BRAND_NAME"
  LOGO = "LOGO"
  COLOR = "COLOR"
  FONT = "FONT"
  VISUAL_STYLE = "VISUAL_STYLE"
  TONE = "TONE"
  TERMINOLOGY = "TERMINOLOGY"
  TAGLINE = "TAGLINE"
  POSITIONING = "POSITIONING"
  DESIGN_PATTERN = "DESIGN_PATTERN"
}

enum IntelligenceAssetMediaType {
  @@type("pg/text@1")

  SCREENSHOT = "SCREENSHOT"
  PRODUCT_UI = "PRODUCT_UI"
  HERO_IMAGE = "HERO_IMAGE"
  ICON = "ICON"
  ILLUSTRATION = "ILLUSTRATION"
  DIAGRAM = "DIAGRAM"
  CHART = "CHART"
  TESTIMONIAL = "TESTIMONIAL"
  BEFORE_AFTER = "BEFORE_AFTER"
  EXISTING_AD = "EXISTING_AD"
  EXISTING_VIDEO = "EXISTING_VIDEO"
  BRAND_ASSET = "BRAND_ASSET"
  OTHER = "OTHER"
}

enum IntelligenceAssetRole {
  @@type("pg/text@1")

  PRODUCT_UI = "PRODUCT_UI"
  FEATURE_PROOF = "FEATURE_PROOF"
  HERO = "HERO"
  SOCIAL_CREATIVE = "SOCIAL_CREATIVE"
  BRAND_ASSET = "BRAND_ASSET"
  SUPPORTING = "SUPPORTING"
}

enum IntelligenceEntityType {
  @@type("pg/text@1")

  PRODUCT = "PRODUCT"
  FEATURE = "FEATURE"
  WORKFLOW = "WORKFLOW"
  PROBLEM = "PROBLEM"
  BENEFIT = "BENEFIT"
  CLAIM = "CLAIM"
  AUDIENCE_SIGNAL = "AUDIENCE_SIGNAL"
  BRAND_SIGNAL = "BRAND_SIGNAL"
  ASSET = "ASSET"
  EVIDENCE = "EVIDENCE"
}

enum IntelligenceRelationshipType {
  @@type("pg/text@1")

  FEATURE_SOLVES_PROBLEM = "FEATURE_SOLVES_PROBLEM"
  FEATURE_PROVIDES_BENEFIT = "FEATURE_PROVIDES_BENEFIT"
  WORKFLOW_USES_FEATURE = "WORKFLOW_USES_FEATURE"
  CLAIM_SUPPORTED_BY_EVIDENCE = "CLAIM_SUPPORTED_BY_EVIDENCE"
  FEATURE_SUPPORTED_BY_EVIDENCE = "FEATURE_SUPPORTED_BY_EVIDENCE"
  BENEFIT_SUPPORTED_BY_EVIDENCE = "BENEFIT_SUPPORTED_BY_EVIDENCE"
  PRODUCT_SUPPORTED_BY_EVIDENCE = "PRODUCT_SUPPORTED_BY_EVIDENCE"
  ASSET_REPRESENTS_FEATURE = "ASSET_REPRESENTS_FEATURE"
  ASSET_SUPPORTS_CLAIM = "ASSET_SUPPORTS_CLAIM"
  PROBLEM_SUPPORTED_BY_EVIDENCE = "PROBLEM_SUPPORTED_BY_EVIDENCE"
  AUDIENCE_SUPPORTED_BY_EVIDENCE = "AUDIENCE_SUPPORTED_BY_EVIDENCE"
  BRAND_SUPPORTED_BY_EVIDENCE = "BRAND_SUPPORTED_BY_EVIDENCE"
}

enum IntelligenceRunStatus {
  @@type("pg/text@1")

  QUEUED = "QUEUED"
  RUNNING = "RUNNING"
  COMPLETED = "COMPLETED"
  FAILED = "FAILED"
  PARTIAL = "PARTIAL"
}

model IntelligenceProduct {
  id                String                     @id @default(cuid(2))
  projectId         String                     @unique
  name              String?
  shortDescription  String?
  longDescription   String?
  category          String?
  purpose           String?
  valueProposition  String?
  targetUserSummary String?
  confidence        IntelligenceConfidence     @default(MEDIUM)
  assertionKind     AssertionKind              @default(INFERENCE)
  userLocked        Boolean                    @default(false)
  sourceIds         String[]
  evidenceIds       String[]
  extractionMethod  ExtractionMethod           @default(DETERMINISTIC)
  extractedAt       TimestamptzString          @default(now())
  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  project           Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@map("intelligence_product")
}

model IntelligenceEvidence {
  id          String                   @id @default(cuid(2))
  projectId   String
  sourceId    String
  kind        IntelligenceEvidenceKind
  locator     String
  excerpt     String?
  metadata    String?
  evidenceKey String
  createdAt   TimestamptzString        @default(now())

  project     Project                  @relation(fields:[projectId], references:[id], onDelete: Cascade)
  source      Source                   @relation(fields:[sourceId], references:[id], onDelete: Cascade)

  @@unique([projectId, evidenceKey], map: "int_evidence_key")
  @@index([projectId, kind], map: "int_evidence_project_kind_idx")
  @@index([sourceId], map: "int_evidence_source_idx")
  @@map("intelligence_evidence")
}

model IntelligenceFeature {
  id               String                     @id @default(cuid(2))
  projectId        String
  name             String
  description      String?
  category         FeatureCategory            @default(OTHER)
  importance       Importance                 @default(SECONDARY)
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_feature_canonical_key")
  @@index([projectId, category], map: "int_feature_project_category_idx")
  @@index([projectId, importance], map: "int_feature_project_importance_idx")
  @@map("intelligence_feature")
}

model IntelligenceProblem {
  id               String                     @id @default(cuid(2))
  projectId        String
  name             String
  description      String?
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_problem_canonical_key")
  @@map("intelligence_problem")
}

model IntelligenceBenefit {
  id               String                     @id @default(cuid(2))
  projectId        String
  name             String
  description      String?
  linkedFeatureIds String[]
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_benefit_canonical_key")
  @@map("intelligence_benefit")
}

model IntelligenceClaim {
  id                   String                     @id @default(cuid(2))
  projectId            String
  text                 String
  claimType            ClaimType                  @default(OTHER)
  sourceId             String?
  verification         ClaimVerification          @default(UNVERIFIED)
  conflictsWithClaimId String?
  confidence           IntelligenceConfidence     @default(MEDIUM)
  assertionKind        AssertionKind              @default(INFERENCE)
  userLocked           Boolean                    @default(false)
  canonicalKey         String
  sourceIds            String[]
  evidenceIds          String[]
  extractionMethod     ExtractionMethod           @default(DETERMINISTIC)
  extractedAt          TimestamptzString          @default(now())
  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()

  project              Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  source               Source?                    @relation(fields:[sourceId], references:[id], onDelete: SetNull)

  @@unique([projectId, canonicalKey], map: "int_claim_canonical_key")
  @@index([projectId, verification], map: "int_claim_project_verification_idx")
  @@index([sourceId], map: "int_claim_source_idx")
  @@map("intelligence_claim")
}

model IntelligenceWorkflow {
  id               String                     @id @default(cuid(2))
  projectId        String
  name             String
  description      String?
  featureIds       String[]
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  steps            IntelligenceWorkflowStep[]

  @@unique([projectId, canonicalKey], map: "int_workflow_canonical_key")
  @@map("intelligence_workflow")
}

model IntelligenceWorkflowStep {
  id          String               @id @default(cuid(2))
  workflowId  String
  order       Int
  action      String
  description String?
  featureIds  String[]

  workflow    IntelligenceWorkflow @relation(fields:[workflowId], references:[id], onDelete: Cascade)

  @@unique([workflowId, order], map: "int_step_workflow_order_key")
  @@map("intelligence_workflow_step")
}

model IntelligenceAudienceSignal {
  id               String                     @id @default(cuid(2))
  projectId        String
  segment          String
  description      String?
  kind             AudienceSignalKind         @default(CONTEXTUAL)
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_audience_canonical_key")
  @@index([projectId, kind], map: "int_audience_project_kind_idx")
  @@map("intelligence_audience_signal")
}

model IntelligenceBrandSignal {
  id               String                     @id @default(cuid(2))
  projectId        String
  kind             BrandSignalKind            @default(TERMINOLOGY)
  label            String
  value            String
  confidence       IntelligenceConfidence     @default(MEDIUM)
  assertionKind    AssertionKind              @default(INFERENCE)
  userLocked       Boolean                    @default(false)
  canonicalKey     String
  sourceIds        String[]
  evidenceIds      String[]
  extractionMethod ExtractionMethod           @default(DETERMINISTIC)
  extractedAt      TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_brand_canonical_key")
  @@index([projectId, kind], map: "int_brand_project_kind_idx")
  @@map("intelligence_brand_signal")
}

model IntelligenceAsset {
  id                String                     @id @default(cuid(2))
  projectId         String
  sourceId          String
  name              String
  mediaType         IntelligenceAssetMediaType @default(OTHER)
  role              IntelligenceAssetRole      @default(SUPPORTING)
  storageKey        String?
  mimeType          String?
  width             Int?
  height            Int?
  durationMs        Int?
  qualitySignals    String?
  relatedFeatureIds String[]
  relatedClaimIds   String[]
  confidence        IntelligenceConfidence     @default(MEDIUM)
  assertionKind     AssertionKind              @default(INFERENCE)
  userLocked        Boolean                    @default(false)
  canonicalKey      String
  sourceIds         String[]
  evidenceIds       String[]
  extractionMethod  ExtractionMethod           @default(DETERMINISTIC)
  extractedAt       TimestamptzString          @default(now())
  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  project           Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  source            Source                     @relation(fields:[sourceId], references:[id], onDelete: Cascade)

  @@unique([projectId, canonicalKey], map: "int_asset_canonical_key")
  @@index([projectId, mediaType], map: "int_asset_project_media_idx")
  @@index([sourceId], map: "int_asset_source_idx")
  @@map("intelligence_asset")
}

model IntelligenceRelationship {
  id         String                       @id @default(cuid(2))
  projectId  String
  type       IntelligenceRelationshipType
  fromType   IntelligenceEntityType
  fromId     String
  toType     IntelligenceEntityType
  toId       String
  confidence IntelligenceConfidence       @default(MEDIUM)
  createdAt  TimestamptzString            @default(now())

  project    Project                      @relation(fields:[projectId], references:[id], onDelete: Cascade)

  @@unique([projectId, type, fromId, toId], map: "int_rel_edge_key")
  @@index([projectId, fromType, fromId], map: "int_rel_from_idx")
  @@index([projectId, toType, toId], map: "int_rel_to_idx")
  @@map("intelligence_relationship")
}

model IntelligenceRun {
  id           String                     @id @default(cuid(2))
  projectId    String
  status       IntelligenceRunStatus      @default(QUEUED)
  sourceIds    String[]
  provider     String?
  model        String?
  trigger      String
  errorCode    String?
  errorMessage String?
  startedAt    TimestamptzString?
  completedAt  TimestamptzString?
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  project      Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  snapshots    IntelligenceSnapshot[]

  @@index([projectId, status], map: "int_run_project_status_idx")
  @@index([projectId, createdAt], map: "int_run_project_created_idx")
  @@map("intelligence_run")
}

enum BrowserSessionStatus {
  @@type("pg/text@1")

  QUEUED = "QUEUED"
  RUNNING = "RUNNING"
  COMPLETED = "COMPLETED"
  FAILED = "FAILED"
  CANCELLED = "CANCELLED"
}

enum BrowserTargetClass {
  @@type("pg/text@1")

  PUBLIC = "PUBLIC"
  CONTROLLED_LOCAL = "CONTROLLED_LOCAL"
}

enum BrowserStepStatus {
  @@type("pg/text@1")

  PENDING = "PENDING"
  RUNNING = "RUNNING"
  COMPLETED = "COMPLETED"
  FAILED = "FAILED"
  SKIPPED = "SKIPPED"
}

/// One browser task: a goal, the target it ran against, and its full trace.
model BrowserSession {
  id              String                     @id @default(cuid(2))
  projectId       String
  targetSourceId  String
  targetClass     BrowserTargetClass
  initialUrl      String
  currentUrl      String
  status          BrowserSessionStatus       @default(QUEUED)
  goal            String?
  successCriteria String?
  planner         String?
  plannerModel    String?
  pageCount       Int                        @default(0)
  actionCount     Int                        @default(0)
  errorCode       String?
  errorMessage    String?
  startedAt       TimestamptzString?
  endedAt         TimestamptzString?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  project         Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  targetSource    Source                     @relation(fields:[targetSourceId], references:[id], onDelete: Cascade)
  steps           BrowserStep[]
  observations    BrowserObservation[]

  @@index([projectId, createdAt], map: "browser_session_project_created_idx")
  @@index([projectId, status], map: "browser_session_project_status_idx")
  @@map("browser_session")
}

/// One validated action plus its before/after state, already redacted.
model BrowserStep {
  id              String             @id @default(cuid(2))
  sessionId       String
  order           Int
  actionType      String
  targetSummary   String?
  inputSummary    String?
  status          BrowserStepStatus  @default(PENDING)
  startedAt       TimestamptzString?
  completedAt     TimestamptzString?
  durationMs      Int?
  stateHashBefore String?
  stateHashAfter  String?
  result          String?
  errorCode       String?
  errorMessage    String?

  session         BrowserSession     @relation(fields:[sessionId], references:[id], onDelete: Cascade)

  @@unique([sessionId, order], map: "browser_step_order")
  @@map("browser_step")
}

/// Compact page state captured around each step, so a trace is reviewable
/// without replaying the session.
model BrowserObservation {
  id        String            @id @default(cuid(2))
  sessionId String
  stepOrder Int
  pageId    String
  url       String
  title     String
  stateHash String
  payload   String
  createdAt TimestamptzString @default(now())

  session   BrowserSession    @relation(fields:[sessionId], references:[id], onDelete: Cascade)

  @@index([sessionId, stepOrder], map: "browser_observation_session_step_idx")
  @@map("browser_observation")
}

model IntelligenceSnapshot {
  id           String            @id @default(cuid(2))
  projectId    String
  version      Int
  runId        String
  summary      String?
  entityCounts String?
  createdAt    TimestamptzString @default(now())

  project      Project           @relation(fields:[projectId], references:[id], onDelete: Cascade)
  run          IntelligenceRun   @relation(fields:[runId], references:[id], onDelete: Cascade)

  @@unique([projectId, version], map: "int_snapshot_version_key")
  @@index([projectId, createdAt], map: "int_snapshot_project_created_idx")
  @@map("intelligence_snapshot")
}

enum BrandOrigin {
  @@type("pg/text@1")

  EXTRACTED = "EXTRACTED"
  INFERRED = "INFERRED"
  USER = "USER"
}

enum BrandPrecedence {
  @@type("pg/text@1")

  INFERENCE = "INFERENCE"
  GENERAL_EXTRACTION = "GENERAL_EXTRACTION"
  RECOGNIZED_ASSET = "RECOGNIZED_ASSET"
  DESIGN_TOKEN = "DESIGN_TOKEN"
  EXPLICIT_GUIDELINE = "EXPLICIT_GUIDELINE"
  USER = "USER"
}

enum BrandConfidence {
  @@type("pg/text@1")

  HIGH = "HIGH"
  MEDIUM = "MEDIUM"
  LOW = "LOW"
}

enum BrandStatus {
  @@type("pg/text@1")

  DRAFT = "DRAFT"
  READY = "READY"
  STALE = "STALE"
}

enum BrandColorRole {
  @@type("pg/text@1")

  PRIMARY = "PRIMARY"
  SECONDARY = "SECONDARY"
  ACCENT = "ACCENT"
  BACKGROUND = "BACKGROUND"
  SURFACE = "SURFACE"
  TEXT = "TEXT"
  MUTED = "MUTED"
  BORDER = "BORDER"
  SUCCESS = "SUCCESS"
  WARNING = "WARNING"
  DANGER = "DANGER"
  NEUTRAL = "NEUTRAL"
}

enum BrandFontRole {
  @@type("pg/text@1")

  HEADING = "HEADING"
  BODY = "BODY"
  DISPLAY = "DISPLAY"
  MONOSPACE = "MONOSPACE"
  UI = "UI"
  CAPTION = "CAPTION"
}

enum BrandAssetRole {
  @@type("pg/text@1")

  LOGO = "LOGO"
  PRIMARY_LOGO = "PRIMARY_LOGO"
  MARK = "MARK"
  WORDMARK = "WORDMARK"
  ICON = "ICON"
  FAVICON = "FAVICON"
  PATTERN = "PATTERN"
  TEXTURE = "TEXTURE"
  ILLUSTRATION = "ILLUSTRATION"
  PHOTOGRAPHY_STYLE = "PHOTOGRAPHY_STYLE"
}

enum BrandTermCategory {
  @@type("pg/text@1")

  FEATURE = "FEATURE"
  PROBLEM = "PROBLEM"
  VALUE_PROP = "VALUE_PROP"
  CALL_TO_ACTION = "CALL_TO_ACTION"
  AUDIENCE = "AUDIENCE"
  COMPETITOR = "COMPETITOR"
  INDUSTRY_TERM = "INDUSTRY_TERM"
}

enum BrandTermPreference {
  @@type("pg/text@1")

  PREFERRED = "PREFERRED"
  AVOID = "AVOID"
  NEUTRAL = "NEUTRAL"
}

/// The canonical brand for one project: the single layer later generators read.
/// Every material value keeps the basis and the provenance that produced it, so
/// a weaker extraction can never overwrite a stronger one and a disagreement
/// stays visible instead of being silently resolved.
model BrandProfile {
  id               String                     @id @default(cuid(2))
  projectId        String
  name             String?
  positioning      String?
  tagline          String?
  valueProposition String?
  voiceSummary     String?
  visualStyle      String?
  textOrigins      String[]
  status           BrandStatus                @default(DRAFT)
  confidence       BrandConfidence            @default(LOW)
  version          Int                        @default(1)
  locked           Boolean                    @default(false)
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  colors           BrandColor[]
  fonts            BrandFont[]
  assets           BrandAsset[]
  terms            BrandTerm[]
  voiceSignals     BrandVoiceSignal[]
  guidelines       BrandGuideline[]
  conflicts        BrandConflict[]

  @@unique([projectId], map: "brand_profile_project_key")
  @@map("brand_profile")
}

model BrandColor {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  name        String
  hex         String
  role        BrandColorRole
  confidence  BrandConfidence            @default(LOW)
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(GENERAL_EXTRACTION)
  sourceIds   String[]
  evidenceIds String[]
  notes       String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, role], map: "brand_color_project_role_idx")
  @@index([profileId], map: "brand_color_profile_idx")
  @@map("brand_color")
}

model BrandFont {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  family      String
  role        BrandFontRole
  weight      String?
  style       String?
  sourceUrl   String?
  confidence  BrandConfidence            @default(LOW)
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(GENERAL_EXTRACTION)
  sourceIds   String[]
  evidenceIds String[]
  notes       String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, role], map: "brand_font_project_role_idx")
  @@index([profileId], map: "brand_font_profile_idx")
  @@map("brand_font")
}

model BrandAsset {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  assetId     String
  role        BrandAssetRole
  label       String
  confidence  BrandConfidence            @default(LOW)
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(RECOGNIZED_ASSET)
  sourceIds   String[]
  evidenceIds String[]
  notes       String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)
  asset       Asset                      @relation(fields:[assetId], references:[id], onDelete: Cascade)

  @@index([projectId, role], map: "brand_asset_project_role_idx")
  @@index([profileId], map: "brand_asset_profile_idx")
  @@map("brand_asset")
}

model BrandTerm {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  term        String
  category    BrandTermCategory          @default(INDUSTRY_TERM)
  preference  BrandTermPreference        @default(NEUTRAL)
  confidence  BrandConfidence            @default(LOW)
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(GENERAL_EXTRACTION)
  sourceIds   String[]
  evidenceIds String[]
  notes       String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, preference], map: "brand_term_project_preference_idx")
  @@index([profileId], map: "brand_term_profile_idx")
  @@map("brand_term")
}

model BrandVoiceSignal {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  kind        String
  value       String
  confidence  BrandConfidence            @default(LOW)
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(RECOGNIZED_ASSET)
  sourceIds   String[]
  evidenceIds String[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, kind], map: "brand_voice_project_kind_idx")
  @@index([profileId], map: "brand_voice_profile_idx")
  @@map("brand_voice_signal")
}

model BrandGuideline {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  title       String
  detail      String
  origin      BrandOrigin                @default(EXTRACTED)
  basis       BrandPrecedence            @default(EXPLICIT_GUIDELINE)
  sourceIds   String[]
  evidenceIds String[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId], map: "brand_guideline_project_idx")
  @@index([profileId], map: "brand_guideline_profile_idx")
  @@map("brand_guideline")
}

/// A disagreement the brand did not resolve silently. Both the retained and the
/// competing assertion stay readable so a reviewer can see what was overruled.
model BrandConflict {
  id          String                     @id @default(cuid(2))
  projectId   String
  profileId   String
  field       String
  retained    String
  competing   String
  resolvedBy  BrandPrecedence
  sourceIds   String[]
  evidenceIds String[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, field], map: "brand_conflict_project_field_idx")
  @@index([profileId], map: "brand_conflict_profile_idx")
  @@map("brand_conflict")
}

/// What the analyzers last read from one source. An unchanged hash means the
/// source is already represented in the profile, so an incremental run skips it.
model BrandSourceState {
  id               String                     @id @default(cuid(2))
  projectId        String
  sourceId         String
  contentHash      String?
  sourceUpdatedAt  TimestamptzString
  analyzerId       String
  analyzerRevision String?
  brandVersion     Int
  analyzedAt       TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  source           Source                     @relation(fields:[sourceId], references:[id], onDelete: Cascade)

  @@unique([projectId, sourceId], map: "brand_source_state_source_key")
  @@index([sourceId], map: "brand_source_state_source_idx")
  @@map("brand_source_state")
}
