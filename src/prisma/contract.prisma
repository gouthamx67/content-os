  updatedAt   temporal.updatedAtString()

  project     Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  profile     BrandProfile               @relation(fields:[profileId], references:[id], onDelete: Cascade)

  @@index([projectId, field], map: "brand_conflict_project_field_idx")
  @@index([profileId], map: "brand_conflict_profile_idx")
  @@map("brand_conflict")
}

/// What the analyzers last read from one source. An unchanged hash means the
/// source is already represented in the profile, so an incremental run skips it.
model BrandSourceState {
  id               String                     @id @default(cuid(2))
  projectId        String
  sourceId         String
  contentHash      String?
  sourceUpdatedAt  TimestamptzString
  analyzerId       String
  analyzerRevision String?
  brandVersion     Int
  analyzedAt       TimestamptzString          @default(now())
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  source           Source                     @relation(fields:[sourceId], references:[id], onDelete: Cascade)

  @@unique([projectId, sourceId], map: "brand_source_state_source_key")
  @@index([sourceId], map: "brand_source_state_source_idx")
  @@map("brand_source_state")
}

/// One content request, resolved as far as the evidence allows. The record is
/// the boundary between "what the user asked for" (CP09) and "what we should
/// make" (CP10): it carries the request, the answer, and how each answer was
/// reached, and it carries no creative direction at all.
model ContentIntent {
  id                  String                     @id @default(cuid(2))
  projectId           String
  rawRequest          String
  channel             ContentChannel
  contentType         String?
  purpose             String?
  platforms           String[]
  audience            String?
  language            String?
  tone                String?
  style               String?
  cta                 String?
  duration            Int?
  quantity            Int                        @default(1)
  aspectRatio         String?
  /// JSON text, matching the rest of the contract: the shapes behind it are
  /// validated in the domain, not by the database.
  constraints         String
  subjects            String
  resolution          IntentResolutionMode
  status              IntentStatus
  confidence          IntentConfidence           @default(MEDIUM)
  /// The fields still being asked about. An empty contentType with this list
  /// holding "contentType" is a draft awaiting an answer, not a broken row.
  unresolved          String[]
  notes               String[]
  sourceIds           String[]
  /// The brand and intelligence versions this reading was made against, so a
  /// later change to either can be traced rather than silently inherited.
  brandVersion        Int?
  intelligenceVersion Int?
  createdAt           TimestamptzString          @default(now())
  updatedAt           temporal.updatedAtString()

  project             Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)

  creativeDirections  CreativeDirection[]
  storyboards         Storyboard[]
  /// Recommendations a user took up as this intent. Reverse side of
  /// ContentRecommendation.selectedIntentId, which is SetNull so deleting the
  /// intent leaves the recommendation standing with no selection.
  recommendations     ContentRecommendation[]

  @@index([projectId], map: "content_intent_project_idx")
  @@index([projectId, createdAt], map: "content_intent_project_created_idx")
  @@index([projectId, status], map: "content_intent_project_status_idx")
  @@map("content_intent")
}

model ContentRecommendation {
  id               String                     @id @default(cuid(2))
  projectId        String
  templateId       String
  /// Stable, refresh-surviving identity of the recommended thing. Canonical
  /// values (content type, subject type, platform) are stored verbatim; the
  /// subject segment carries its own id or a slug of its label. Scoped to the
  /// project rather than unique on its own: the key says what is recommended,
  /// and two projects may well recommend the same thing.
  key              String
  contentTypeId    String
  channel          OpportunityChannel
  platform         String
  subjectType      String
  subjectId        String?
  subjectLabel     String
  title            String
  rationale        String
  /// Reasons are advisory text, never the score. The score is persisted so a
  /// refresh re-ranks deterministically, but it is dropped before anything is
  /// serialized to a client.
  reasons          String[]
  missingInputs    String[]
  priorityScore    Float
  /// Real Source document ids the subject was grounded in, resolved from CP06
  /// provenance. Never an intelligence entity id: selecting the recommendation
  /// copies these into a CP09 intent, which validates them against Source rows.
  sourceIds        String[]
  /// CP06 evidence ids backing the subject's entities.
  evidenceIds      String[]
  /// Related intelligence entity ids, e.g. the features a workflow steps through.
  /// Kept apart from sourceIds so an entity id can never enter intent provenance.
  /// Defaults to empty because rows written before this split never recorded
  /// related entities, and "none known" is the honest value for them.
  entityIds        String[]                   @default([])
  status           OpportunityStatus          @default(ACTIVE)
  selectedIntentId String?
  dismissedAt      TimestamptzString?
  generatedAt      TimestamptzString
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  project          Project                    @relation(fields:[projectId], references:[id], onDelete: Cascade)
  selectedIntent   ContentIntent?             @relation(fields:[selectedIntentId], references:[id], onDelete: SetNull)

  @@index([projectId], map: "content_recommendation_project_idx")
  @@index([projectId, status], map: "content_recommendation_project_status_idx")
  @@index([subjectType, subjectId], map: "content_recommendation_subject_idx")
  @@unique([projectId, key], map: "content_recommendation_project_key_key")
  @@map("content_recommendation")
}

