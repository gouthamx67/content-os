      {
        "description": "create table \"content_intent\"",
        "sql": "CREATE TABLE \"public\".\"content_intent\" (\n  \"aspectRatio\" text,\n  \"audience\" text,\n  \"brandVersion\" int4,\n  \"channel\" text NOT NULL,\n  \"confidence\" text DEFAULT 'MEDIUM' NOT NULL,\n  \"constraints\" text NOT NULL,\n  \"contentType\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"cta\" text,\n  \"duration\" int4,\n  \"id\" text NOT NULL,\n  \"intelligenceVersion\" int4,\n  \"language\" text,\n  \"notes\" text[] NOT NULL,\n  \"platforms\" text[] NOT NULL,\n  \"projectId\" text NOT NULL,\n  \"purpose\" text,\n  \"quantity\" int4 DEFAULT 1 NOT NULL,\n  \"rawRequest\" text NOT NULL,\n  \"resolution\" text NOT NULL,\n  \"sourceIds\" text[] NOT NULL,\n  \"status\" text NOT NULL,\n  \"style\" text,\n  \"subjects\" text NOT NULL,\n  \"tone\" text,\n  \"unresolved\" text[] NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"content_intent_channel_check_1c241ad4\" CHECK (\"channel\" IN ('VIDEO', 'IMAGE', 'TEXT', 'AUDIO', 'CAMPAIGN')),\n  CONSTRAINT \"content_intent_confidence_check_15ae8318\" CHECK (\"confidence\" IN ('HIGH', 'MEDIUM', 'LOW')),\n  CONSTRAINT \"content_intent_notes_elem_not_null_f914e30f\" CHECK (array_position(\"notes\", NULL) IS NULL),\n  CONSTRAINT \"content_intent_platforms_elem_not_null_53a1bdb5\" CHECK (array_position(\"platforms\", NULL) IS NULL),\n  CONSTRAINT \"content_intent_resolution_check_eb7780a0\" CHECK (\"resolution\" IN ('EXPLICIT', 'INFERRED', 'PARTIAL', 'NEEDS_CLARIFICATION')),\n  CONSTRAINT \"content_intent_sourceIds_elem_not_null_07253a8e\" CHECK (array_position(\"sourceIds\", NULL) IS NULL),\n  CONSTRAINT \"content_intent_status_check_f3b4e003\" CHECK (\"status\" IN ('DRAFT', 'RESOLVED', 'NEEDS_CLARIFICATION', 'BLOCKED')),\n  CONSTRAINT \"content_intent_unresolved_elem_not_null_b05bd153\" CHECK (array_position(\"unresolved\", NULL) IS NULL)\n)",
        "params": []
      }
