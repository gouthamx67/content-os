      {
        "description": "create table \"content_recommendation\"",
        "sql": "CREATE TABLE \"public\".\"content_recommendation\" (\n  \"channel\" text NOT NULL,\n  \"contentTypeId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dismissedAt\" timestamptz,\n  \"evidenceIds\" text[] NOT NULL,\n  \"generatedAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"isProgress\" bool DEFAULT false NOT NULL,\n  \"key\" text NOT NULL,\n  \"missingInputs\" text[] NOT NULL,\n  \"platform\" text NOT NULL,\n  \"priorityScore\" float8 NOT NULL,\n  \"projectId\" text NOT NULL,\n  \"rationale\" text NOT NULL,\n  \"reasons\" text[] NOT NULL,\n  \"selectedIntentId\" text,\n  \"sourceIds\" text[] NOT NULL,\n  \"status\" text DEFAULT 'ACTIVE' NOT NULL,\n  \"subjectId\" text,\n  \"subjectLabel\" text NOT NULL,\n  \"subjectType\" text NOT NULL,\n  \"templateId\" text NOT NULL,\n  \"title\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"content_recommendation_channel_check_1c241ad4\" CHECK (\"channel\" IN ('VIDEO', 'IMAGE', 'TEXT', 'AUDIO', 'CAMPAIGN')),\n  CONSTRAINT \"content_recommendation_evidenceIds_elem_not_null_4d0cb530\" CHECK (array_position(\"evidenceIds\", NULL) IS NULL),\n  CONSTRAINT \"content_recommendation_missingInputs_elem_not_null_066d9444\" CHECK (array_position(\"missingInputs\", NULL) IS NULL),\n  CONSTRAINT \"content_recommendation_reasons_elem_not_null_3036d3dd\" CHECK (array_position(\"reasons\", NULL) IS NULL),\n  CONSTRAINT \"content_recommendation_sourceIds_elem_not_null_07253a8e\" CHECK (array_position(\"sourceIds\", NULL) IS NULL),\n  CONSTRAINT \"content_recommendation_status_check_c43b5441\" CHECK (\"status\" IN ('ACTIVE', 'DISMISSED', 'SELECTED'))\n)",
        "params": []
      }
    ],
